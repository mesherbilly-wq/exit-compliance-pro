# Resend inbound email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=inbound-csv

# Inbound report destination shown in the UI
INBOUND_REPORT_EMAIL=

# Optional attachment size limit in bytes (default: 10485760)
INBOUND_MAX_ATTACHMENT_BYTES=10485760

# Failed import CSV retention in days (default: 7)
FAILED_CSV_RETENTION_DAYS=7
